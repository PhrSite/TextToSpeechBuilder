<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Allows the user to build a Windows WAVE (*.wav) file from a string of text. The WAVE files created by this application can be used in VoIP applications for playing prerecorded audio to a call party.
</Description>
    <Authors>Philip Reichl</Authors>
    <Company>PhrSite</Company>
    <Title>Text To Speech Builder</Title>
    <Copyright>Copyright 2026 Philip Reichl</Copyright>
    <PackageProjectUrl>https://phrsite.github.io/TextToSpeechBuilder</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/PhrSite/TextToSpeechBuilder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>VoIP;Ng9-1-1</PackageTags>
    <PackageReleaseNotes>Version 1.0.0 - Initial Release</PackageReleaseNotes>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.3" />
  </ItemGroup>

</Project>